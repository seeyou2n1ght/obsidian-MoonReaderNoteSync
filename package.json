{
  "name": "ob-moonreadernotesync",
  "version": "0.3.2",
  "description": "Import Moon+ Reader highlights and annotations from WebDAV backups into your notes.",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run check:bundle",
    "check:bundle": "node tests/verify-build.mjs",
    "check:release": "node tests/verify-build.mjs --tag"
  },
  "keywords": [],
  "author": "seeyou2night",
  "license": "ISC",
  "type": "commonjs",
  "overrides": {
    "obsidian": {
      "moment": "2.31.0"
    }
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/pako": "^2.0.4",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "obsidian": "^1.13.1",
    "pako": "^2.1.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  }
}
